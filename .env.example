# CodeWiki Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Server Configuration
# =============================================================================

# Port to run the server on (default: 3000)
PORT=3000

# Base URL of your application (used for OAuth callbacks)
# In production, set this to your actual domain
BASE_URL=http://localhost:3000

# Node environment: development, production, or test
NODE_ENV=development

# =============================================================================
# Authentication
# =============================================================================

# Password protection for the site (optional)
# If set, users must enter this password to access the application
# SITE_PASSWORD=your-site-password

# Session secret for signing cookies and JWTs
# Generate a secure random string for production
# SESSION_SECRET=your-secure-random-secret-here

# =============================================================================
# GitHub OAuth (required for "Login with GitHub" feature)
# =============================================================================

# Get these from your GitHub App settings:
# Settings -> Developer settings -> GitHub Apps -> Your App

# OAuth Client ID from your GitHub App
# GITHUB_APP_CLIENT_ID=Iv1.abc123def456

# OAuth Client Secret from your GitHub App
# GITHUB_APP_CLIENT_SECRET=your_client_secret_here

# Your GitHub App's URL-friendly name (the slug in the URL)
# Used to generate the installation URL for users to grant repo access
# GITHUB_APP_NAME=your-app-name

# =============================================================================
# LLM Configuration (OpenRouter)
# =============================================================================

# OpenRouter API key for LLM-powered features
# Get one at https://openrouter.ai/
# OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter model to use (default: anthropic/claude-sonnet-4)
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Preferred OpenRouter provider (optional)
# Set to prioritize a specific provider (e.g., anthropic, openai, together)
# Falls back to other providers if the preferred one is unavailable
# OPENROUTER_PROVIDER=anthropic

# Whether to allow fallback to other providers when preferred is unavailable (default: true)
# Set to false to enforce exclusive use of the preferred provider (requests will fail if unavailable)
# OPENROUTER_PROVIDER_ALLOW_FALLBACKS=true

# =============================================================================
# Database Configuration
# =============================================================================

# MongoDB connection URI (optional - uses file-based storage if not set)
# MONGODB_URI=mongodb://localhost:27017

# MongoDB database name (default: codewiki)
# MONGODB_DB_NAME=codewiki

# Path for file-based data storage (default: .codewiki-data)
# CODEWIKI_DATA_PATH=.codewiki-data

# =============================================================================
# Proxy Configuration (optional)
# =============================================================================

# HTTP proxy for outgoing requests
# HTTP_PROXY=http://proxy.example.com:8080
# http_proxy=http://proxy.example.com:8080

# HTTPS proxy for outgoing requests
# HTTPS_PROXY=http://proxy.example.com:8080
# https_proxy=http://proxy.example.com:8080
