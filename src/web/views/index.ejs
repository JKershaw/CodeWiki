<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CodeWiki</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div id="app">
    <header>
      <div class="header-main">
        <div class="header-brand">
          <h1>CodeWiki</h1>
          <p class="tagline">Living documentation from your Git history</p>
        </div>
        <div id="user-section" class="user-section">
          <!-- User info populated by JavaScript -->
        </div>
      </div>
    </header>

    <nav id="nav">
      <button class="nav-btn active" data-view="repos">Repositories</button>
      <button class="nav-btn" data-view="wiki" disabled>Wiki</button>
      <button class="nav-btn" data-view="query" disabled>Ask</button>
      <button class="nav-btn" data-view="spec" disabled>Spec</button>
      <button class="nav-btn" data-view="benchmark" disabled>Benchmark</button>
      <button class="nav-btn" data-view="debug" disabled>Debug</button>
    </nav>

    <main>
      <!-- Repositories View -->
      <section id="repos-view" class="view active">
        <div class="section-header">
          <h2>Repositories</h2>
          <button id="add-repo-btn" class="btn primary">Add Repository</button>
        </div>

        <div id="add-repo-form" class="form-container hidden">
          <div class="repo-source-toggle">
            <button id="source-local-btn" class="toggle-btn active" data-source="local">Local Folder</button>
            <button id="source-github-btn" class="toggle-btn" data-source="github">GitHub URL</button>
          </div>

          <div id="local-source-panel">
            <div id="folder-browser">
              <div class="browser-header">
                <button id="browser-up-btn" class="btn secondary">↑ Up</button>
                <span id="browser-path"></span>
              </div>
              <div id="folder-list"></div>
            </div>
          </div>

          <div id="github-source-panel" class="hidden">
            <!-- Accessible repos section (shown when logged in) -->
            <div id="github-repos-section" class="github-repos-section hidden">
              <div class="github-repos-header">
                <label>Your Repositories</label>
                <a id="github-manage-access" href="#" target="_blank" class="manage-access-link" title="Add or remove repository access">Manage access</a>
              </div>
              <div id="github-repos-list" class="github-repos-list">
                <p class="loading">Loading repositories...</p>
              </div>
            </div>

            <!-- Empty state (shown when logged in but no repos) -->
            <div id="github-empty-state" class="github-empty-state hidden">
              <div class="empty-state-content">
                <h4>Connect Your Repositories</h4>
                <p>Install the CodeWiki GitHub App to access your repositories, including private ones.</p>
                <a id="github-install-app" href="#" target="_blank" class="btn primary">Install GitHub App</a>
              </div>
            </div>

            <!-- Login prompt (shown when not logged in) -->
            <div id="github-login-prompt" class="github-login-prompt hidden">
              <p>Log in with GitHub to access your private repositories, or enter a public repo URL below.</p>
              <a href="/auth/github" class="btn secondary">Login with GitHub</a>
            </div>

            <!-- Manual URL input (always available) -->
            <div class="github-url-section">
              <div class="github-url-divider">
                <span>or enter repository URL</span>
              </div>
              <div class="github-url-input">
                <input type="url" id="github-url" placeholder="https://github.com/owner/repository" />
                <p class="input-hint">Works with public repos, or private repos you've granted access to.</p>
              </div>
            </div>

            <!-- Error message for access issues -->
            <div id="github-access-error" class="github-access-error hidden">
              <div class="error-content">
                <strong>Can't access this repository</strong>
                <p>This might be a private repo. To access it, install the GitHub App and grant access to this repository.</p>
                <a id="github-error-install" href="#" target="_blank" class="btn secondary">Install GitHub App</a>
              </div>
            </div>
          </div>

          <div class="browser-actions">
            <button id="submit-repo-btn" class="btn primary" disabled>Add Selected</button>
            <button id="cancel-repo-btn" class="btn secondary">Cancel</button>
          </div>
        </div>

        <div id="repos-list" class="card-list">
          <p class="loading">Loading repositories...</p>
        </div>
      </section>

      <!-- Wiki View -->
      <section id="wiki-view" class="view">
        <div class="section-header">
          <h2>Wiki: <span id="wiki-repo-name"></span></h2>
          <div class="header-actions">
            <select id="wiki-selector" class="wiki-selector">
              <option value="">Loading wikis...</option>
            </select>
            <button id="delete-wiki-btn" class="btn danger small" title="Delete this wiki">Delete Wiki</button>
            <button id="back-to-repos" class="btn secondary">Back to Repos</button>
          </div>
        </div>

        <div class="wiki-layout">
          <aside id="wiki-sidebar">
            <h3>Pages</h3>
            <div id="wiki-categories"></div>
          </aside>

          <article id="wiki-content">
            <p class="placeholder">Select a page from the sidebar</p>
          </article>
        </div>
      </section>

      <!-- Query View -->
      <section id="query-view" class="view">
        <div class="section-header">
          <h2>Ask: <span id="query-repo-name"></span></h2>
          <button id="back-to-repos-query" class="btn secondary">Back to Repos</button>
        </div>

        <div class="agent-container">
          <div class="agent-input-section">
            <label for="query-question">Ask a question about the codebase</label>
            <textarea id="query-question" placeholder="e.g., How does authentication work? What patterns are used for API endpoints?" rows="6"></textarea>
            <div class="agent-actions">
              <button id="submit-query" class="btn primary">Ask</button>
            </div>
          </div>

          <div id="query-result" class="agent-result hidden">
            <div class="result-header">
              <h3>Answer</h3>
            </div>
            <div id="query-answer" class="result-content"></div>
            <div id="query-meta" class="result-meta"></div>
            <div id="query-sources" class="result-sources"></div>
          </div>
        </div>
      </section>

      <!-- Spec View -->
      <section id="spec-view" class="view">
        <div class="section-header">
          <h2>Spec: <span id="spec-repo-name"></span></h2>
          <button id="back-to-repos-spec" class="btn secondary">Back to Repos</button>
        </div>

        <div class="agent-container">
          <div class="agent-input-section">
            <label for="spec-task">Describe the task for a coding agent</label>
            <textarea id="spec-task" placeholder="e.g., Add a new API endpoint for user preferences that follows the existing patterns..." rows="6"></textarea>
            <div class="agent-actions">
              <button id="submit-spec" class="btn primary">Generate Spec</button>
            </div>
          </div>

          <div id="spec-result" class="agent-result hidden">
            <div class="result-header">
              <h3>Generated Specification</h3>
              <button id="copy-spec" class="btn secondary">Copy</button>
            </div>
            <div id="spec-content" class="result-content"></div>
            <div id="spec-meta" class="result-meta"></div>
            <div id="spec-sources" class="result-sources"></div>
          </div>
        </div>
      </section>

      <!-- Benchmark View -->
      <section id="benchmark-view" class="view">
        <div class="section-header">
          <h2>Benchmark: <span id="benchmark-repo-name"></span></h2>
          <button id="back-to-repos-benchmark" class="btn secondary">Back to Repos</button>
        </div>

        <div class="benchmark-container">
          <div class="benchmark-actions">
            <button id="run-benchmark-btn" class="btn primary">Run Accuracy</button>
            <button id="run-quality-benchmark-btn" class="btn primary">Run Quality</button>
            <button id="run-both-benchmarks-btn" class="btn secondary">Run Both</button>
            <span id="benchmark-status-text" class="benchmark-status-text"></span>
          </div>

          <!-- Auto Benchmark Section -->
          <div class="auto-benchmark-section">
            <div class="auto-benchmark-config">
              <label>
                Iterations per cycle:
                <input type="number" id="auto-benchmark-iterations" value="5" min="1" max="50">
              </label>
              <label>
                Max cycles:
                <input type="number" id="auto-benchmark-max-cycles" value="10" min="1" max="100">
              </label>
              <label class="checkbox-label">
                <input type="checkbox" id="auto-benchmark-include-quality" checked>
                Include Quality
              </label>
              <button id="auto-benchmark-btn" class="btn primary">Start Auto Benchmark</button>
              <button id="stop-auto-benchmark-btn" class="btn danger hidden">Stop</button>
            </div>
            <div id="auto-benchmark-progress" class="auto-benchmark-progress hidden">
              <div class="auto-benchmark-status">
                <span id="auto-benchmark-cycle">Cycle 0/0</span>
                <span id="auto-benchmark-phase">-</span>
              </div>
              <div class="progress-bar">
                <div class="progress-fill" id="auto-benchmark-progress-fill"></div>
              </div>
              <div id="auto-benchmark-status-text" class="progress-text"></div>
            </div>
          </div>

          <div id="benchmark-progress" class="benchmark-progress hidden">
            <div class="progress-bar">
              <div class="progress-fill" id="benchmark-progress-fill"></div>
            </div>
            <div class="progress-text" id="benchmark-progress-text">Starting benchmark...</div>
          </div>

          <div class="benchmark-history-section">
            <h3>History</h3>
            <div id="benchmark-chart-container" class="benchmark-chart-container hidden">
              <canvas id="benchmark-chart"></canvas>
            </div>
            <div id="benchmark-history" class="benchmark-history">
              <p class="placeholder">No benchmarks yet. Run one to measure wiki quality.</p>
            </div>
          </div>

          <!-- Self-Improvement Analysis Section -->
          <div class="self-improvement-section">
            <h3>Self-Improvement Analysis</h3>
            <p class="section-hint">Select 2 or more completed accuracy benchmarks to analyze trends and get improvement recommendations.</p>
            <div class="self-improvement-controls">
              <div id="benchmark-selector" class="benchmark-selector">
                <p class="placeholder">Run benchmarks to enable analysis.</p>
              </div>
              <div class="self-improvement-actions">
                <button id="run-self-improvement-btn" class="btn primary" disabled>Analyze Selected</button>
                <button id="select-all-benchmarks-btn" class="btn secondary">Select All</button>
                <button id="clear-benchmark-selection-btn" class="btn secondary">Clear</button>
              </div>
            </div>
            <div id="self-improvement-status" class="self-improvement-status hidden">
              <p>Analysis in progress...</p>
            </div>
            <div id="self-improvement-report" class="self-improvement-report hidden">
              <div class="report-header">
                <h4>Analysis Report</h4>
                <button id="close-report-btn" class="btn secondary">Close</button>
              </div>
              <div id="report-content" class="report-content"></div>
              <div id="analysis-trace-section" class="analysis-trace-section hidden">
                <button id="toggle-trace-btn" class="trace-toggle-btn">
                  <span class="toggle-icon">▶</span>
                  <span class="toggle-text">Show Analysis Trace</span>
                  <span id="trace-summary" class="trace-summary"></span>
                </button>
                <div id="analysis-trace-content" class="analysis-trace-content hidden"></div>
              </div>

              <!-- Chat Section for Follow-up Questions -->
              <div id="chat-section" class="chat-section">
                <div class="chat-header">
                  <h4>💬 Ask Follow-up Questions</h4>
                  <span id="chat-status" class="chat-status"></span>
                  <span id="chat-cost" class="chat-cost"></span>
                </div>
                <div id="chat-messages" class="chat-messages">
                  <div class="chat-welcome">
                    <p>Ask questions about this analysis. The AI has access to the report and can investigate further using the same tools.</p>
                  </div>
                </div>
                <div class="chat-input-area">
                  <textarea id="chat-input" placeholder="Ask about the analysis..." rows="2" disabled></textarea>
                  <button id="send-chat-btn" class="btn primary" disabled>Send</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Benchmark Detail Modal/Panel -->
        <div id="benchmark-detail" class="benchmark-detail hidden">
          <div class="benchmark-detail-header">
            <h3>Benchmark Details</h3>
            <button id="close-benchmark-detail" class="btn secondary">Close</button>
          </div>
          <div id="benchmark-detail-content"></div>
        </div>
      </section>

      <!-- Debug/Observability View -->
      <section id="debug-view" class="view">
        <div class="section-header">
          <h2>Debug: <span id="debug-repo-name"></span></h2>
          <button id="back-to-repos-debug" class="btn secondary">Back to Repos</button>
        </div>

        <div class="debug-container">
          <!-- Summary Cards -->
          <div id="debug-summary" class="debug-summary">
            <div class="summary-card">
              <h4>Total Cost</h4>
              <div class="summary-value" id="debug-total-cost">$0.00</div>
              <div class="summary-breakdown">
                <span>Orchestrator: <span id="debug-orchestrator-cost">$0.00</span></span>
                <span>Agents: <span id="debug-agent-cost">$0.00</span></span>
              </div>
            </div>
            <div class="summary-card">
              <h4>Agent Runs</h4>
              <div class="summary-value" id="debug-total-runs">0</div>
              <div class="summary-breakdown">
                <span class="status-completed">Completed: <span id="debug-completed-runs">0</span></span>
                <span class="status-failed">Failed: <span id="debug-failed-runs">0</span></span>
              </div>
            </div>
            <div class="summary-card">
              <h4>Success Rate</h4>
              <div class="summary-value" id="debug-success-rate">100%</div>
            </div>
            <div class="summary-card">
              <h4>Orchestrator Decisions</h4>
              <div class="summary-value" id="debug-orchestrator-runs">0</div>
              <div class="summary-breakdown">
                <span>LLM: <span id="debug-llm-decisions">0</span></span>
                <span>Deterministic: <span id="debug-deterministic-decisions">0</span></span>
              </div>
            </div>
          </div>

          <!-- Tabs for different views -->
          <div class="debug-tabs">
            <button class="debug-tab active" data-tab="orchestrator">Orchestrator Decisions</button>
            <button class="debug-tab" data-tab="agents">Agent Runs</button>
          </div>

          <!-- Orchestrator Decisions Tab -->
          <div id="debug-orchestrator-tab" class="debug-tab-content active">
            <div class="debug-controls">
              <label>
                <input type="checkbox" id="debug-filter-llm"> LLM only
              </label>
              <button id="debug-refresh-orchestrator" class="btn secondary small">Refresh</button>
            </div>
            <div id="debug-orchestrator-list" class="debug-list">
              <p class="placeholder">Loading orchestrator decisions...</p>
            </div>
          </div>

          <!-- Agent Runs Tab -->
          <div id="debug-agents-tab" class="debug-tab-content">
            <div class="debug-controls">
              <select id="debug-agent-filter">
                <option value="">All Agents</option>
              </select>
              <select id="debug-status-filter">
                <option value="">All Statuses</option>
                <option value="completed">Completed</option>
                <option value="failed">Failed</option>
                <option value="running">Running</option>
                <option value="pending">Pending</option>
              </select>
              <button id="debug-refresh-agents" class="btn secondary small">Refresh</button>
            </div>
            <div id="debug-agents-list" class="debug-list">
              <p class="placeholder">Loading agent runs...</p>
            </div>
          </div>

          <!-- Detail Panel (shown when clicking an item) -->
          <div id="debug-detail-panel" class="debug-detail-panel hidden">
            <div class="detail-header">
              <h3 id="debug-detail-title">Details</h3>
              <button id="debug-close-detail" class="btn secondary small">Close</button>
            </div>
            <div id="debug-detail-content" class="detail-content"></div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <p>CodeWiki - Generate living wikis from Git repositories</p>
      <div class="model-selector-container">
        <label for="model-selector">Model:</label>
        <select id="model-selector" class="model-selector">
          <option value="">Loading...</option>
        </select>
      </div>
      <div id="version-info" class="version-info">
        <span id="version-text">Loading version...</span>
      </div>
    </footer>

    <!-- Confirmation Modal -->
    <div id="confirm-modal" class="modal-overlay hidden">
      <div class="modal-content">
        <div class="modal-header">
          <h3 id="modal-title">Confirm Action</h3>
        </div>
        <div class="modal-body">
          <p id="modal-message">Are you sure?</p>
          <div id="modal-details" class="modal-details"></div>
        </div>
        <div class="modal-actions">
          <button id="modal-cancel-btn" class="btn secondary">Cancel</button>
          <button id="modal-confirm-btn" class="btn danger">Delete</button>
        </div>
      </div>
    </div>

    <!-- Toast Notifications Container -->
    <div id="toast-container" class="toast-container"></div>
  </div>

  <!-- Markdown parsing library -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <!-- HTML sanitization to prevent XSS attacks -->
  <script src="https://cdn.jsdelivr.net/npm/dompurify/dist/purify.min.js"></script>
  <!-- Chart.js for benchmark visualization -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <!-- Application modules (must load before app.js) -->
  <script src="/modules/utils.js"></script>
  <script src="/modules/api.js"></script>
  <script src="/modules/ui.js"></script>
  <script src="/modules/state.js"></script>
  <!-- Feature modules -->
  <script src="/modules/config.js"></script>
  <script src="/modules/auth.js"></script>
  <script src="/modules/github.js"></script>
  <script src="/modules/browser.js"></script>
  <script src="/modules/repos.js"></script>
  <script src="/modules/wiki.js"></script>
  <script src="/modules/query.js"></script>
  <script src="/modules/spec.js"></script>
  <script src="/modules/benchmark.js"></script>
  <script src="/modules/chat.js"></script>
  <script src="/modules/debug.js"></script>
  <!-- Main application entry point -->
  <script src="/app.js"></script>
</body>
</html>
