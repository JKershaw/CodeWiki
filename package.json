{
  "name": "codewiki",
  "version": "0.1.0",
  "description": "Generate living wikis from Git repositories",
  "type": "module",
  "engines": {
    "node": ">=20.4.0"
  },
  "bin": {
    "codewiki": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "ask": "tsx src/cli.ts ask",
    "mcp": "tsx src/mcp/server.ts",
    "web": "tsx src/web/server.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.3.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "fast-glob": "^3.3.2",
    "marked": "^17.0.1",
    "minimatch": "^10.0.1",
    "mongodb": "^6.3.0",
    "simple-git": "^3.22.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.25",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "jsdom": "^27.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2",
    "undici": "^7.16.0"
  }
}
