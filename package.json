{
  "name": "codewiki",
  "version": "0.1.0",
  "description": "Generate living wikis from Git repositories",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "codewiki": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/web/public dist/web/ && cp -r src/web/views dist/web/ && cp -r src/benchmark/questions dist/benchmark/",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "ask": "tsx src/cli.ts ask",
    "mcp": "tsx src/mcp/server.ts",
    "web": "tsx src/web/server.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:coverage": "c8 --include 'src/**' --exclude 'src/**/*.d.ts' --reporter text-summary --reporter html node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:llm": "node --import tsx --test tests/llm/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@octokit/rest": "^22.0.1",
    "cookie-parser": "^1.4.7",
    "diff": "^8.0.2",
    "dompurify": "^3.3.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "fast-glob": "^3.3.2",
    "ignore": "^7.0.5",
    "isomorphic-git": "^1.35.1",
    "jsonwebtoken": "^9.0.2",
    "marked": "^17.0.1",
    "minimatch": "^10.0.1",
    "mongodb": "^6.3.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.25",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "c8": "^10.1.3",
    "eslint": "^8.55.0",
    "jsdom": "^27.2.0",
    "mongodb-memory-server": "^10.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2",
    "undici": "^7.16.0"
  }
}
